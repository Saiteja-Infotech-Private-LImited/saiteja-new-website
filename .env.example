# Copy this file to .env and replace the placeholder values.
# Do not commit .env. Never put real production passwords here.

# MySQL (official mysql:8 image). Required by compose.yaml.
MYSQL_ROOT_PASSWORD=change-me

# Spring Boot datasource. Password should match MYSQL_ROOT_PASSWORD when using root.
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=change-me

# Optional. Default JDBC URL in application.properties already uses host "mysql"
# and database "saiteja_website". Override only if you need a different URL.
# SPRING_DATASOURCE_URL=jdbc:mysql://mysql:3306/saiteja_website?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC

# Optional. Comma-separated browser origins for CORS.
# Same-origin nginx (/api proxy) does not require extra origins for form POSTs.
# Keep localhost:5173 for local Vite (`npm run dev`).
CORS_ALLOWED_ORIGINS=http://localhost:5173
